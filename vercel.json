{
  "rewrites": [
    {
      "source": "/v1/verify",
      "destination": "/api/verify"
    },
    {
      "source": "/shield/v1/widget.js",
      "destination": "/widget.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
